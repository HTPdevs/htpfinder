# Copy to .env and fill in. .env is gitignored.

# Google Places, used by `htpfinder collect`. Without it, collect only runs
# against the recorded fixtures in cli/fixtures/.
GOOGLE_PLACES_API_KEY=

# Supabase, where scraped prospect data lives.
#
# The URL and the publishable key are not secrets. They ship in any client
# bundle by design, and every table they can reach is behind row level security
# that scopes rows to the signed in user. Read supabase/README.md before
# assuming that means they are safe to hand out anyway.
SUPABASE_URL=https://xyxvmxrgwzyvojydatwu.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# The account the CLI signs in as. RLS keys off this user, so prospects
# collected under one login are invisible to any other.
SUPABASE_EMAIL=
SUPABASE_PASSWORD=

# GitHub and Google OAuth apps, for signing into the control panel (ui/).
# Nothing in this repo reads these: they only ever go into the Supabase
# Dashboard, under Authentication > Providers. See ui/README.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Not listed on purpose: the service role key. It bypasses row level security
# entirely, which makes every protection in supabase/migrations/ decorative.
# Nothing in this tool needs it. If something ever does, that thing runs on a
# server, not on a laptop and not in a demo build.
